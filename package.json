{
  "name": "meetscribe",
  "version": "1.1.1",
  "description": "Meeting transcription overlay — live speaker-labeled transcript, invisible to screen sharing",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js --no-sandbox",
    "setup:whisper": "node scripts/setup-whisper.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "dist": "npm run build",
    "pack": "electron-builder --dir",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "rebuild": "npm run clean && npm run build",
    "postinstall": "electron-builder install-app-deps",
    "check": "node scripts/check.js",
    "build:installer": "electron-builder --win nsis --publish never",
    "deploy": "node scripts/deploy-local.js"
  },
  "author": {
    "name": "AmineChr54",
    "url": "https://github.com/AmineChr54"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmineChr54/MeetScribe.git"
  },
  "bugs": {
    "url": "https://github.com/AmineChr54/MeetScribe/issues"
  },
  "homepage": "https://github.com/AmineChr54/MeetScribe#readme",
  "license": "Apache-2.0",
  "keywords": [
    "electron",
    "whisper",
    "faster-whisper",
    "transcription",
    "meeting-notes",
    "privacy",
    "overlay",
    "windows"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.meetscribe.app",
    "productName": "MeetScribe",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!*.md",
      "!.git/**/*",
      "!.env*",
      "!.venv-whisper/**/*",
      "!.whisper-models/**/*",
      "!bin/**/*",
      "!scripts/__pycache__/**/*",
      "!**/*.pyc"
    ],
    "asarUnpack": [
      "assets/brand/**/*",
      "assests/icons/**/*",
      "scripts/whisper_worker.py",
      "scripts/whisper_offline.py",
      "scripts/transcode_flac.py",
      "scripts/setup-whisper.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/brand/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "include": "scripts/post-install-nsis.nsh",
      "deleteAppDataOnUninstall": false,
      "artifactName": "MeetScribe-Setup-${version}.${ext}",
      "installerIcon": "assets/brand/icon.ico",
      "uninstallerIcon": "assets/brand/icon.ico",
      "installerHeaderIcon": "assets/brand/icon.ico",
      "shortcutName": "MeetScribe"
    },
    "publish": {
      "provider": "github",
      "owner": "AmineChr54",
      "repo": "MeetScribe"
    }
  }
}
